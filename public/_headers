# Cloudflare Pages _headers file
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
#
# Cache strategy:
# - _next/static/*  → 1 year immutable (Next.js hashed filenames already bust cache)
# - /learn/*        → 1 day edge cache (HTML, content changes occasionally)
# - /icons / og-image → 1 week
# - All other HTML  → default (no override, browser handles)
# - /api/* (Pages Functions) → no cache

# 1. Next.js static assets — hashed filenames, safe to cache 1 year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 2. /learn/* articles — cache at edge 1 day, SWR 7 days
#    HTML files only; subdirectories (article pages) also match
/learn/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 3. OG image and brand icons — long cache (rarely change)
/og-image.png
  Cache-Control: public, max-age=604800, immutable
/icon.svg
  Cache-Control: public, max-age=604800, immutable
/favicon.ico
  Cache-Control: public, max-age=604800, immutable

# 4. Pages Functions — never cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate

# 5. Sitemap & robots — serve as XML/text, cache 1 hour at edge
#    Sitemap updates infrequently; 1 hour edge cache keeps load low
#    without delaying Googlebot discovery of new URLs.
#    Cloudflare Pages' default for static .xml is text/plain or omits
#    Content-Type — explicitly set to the standard sitemap type.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate
