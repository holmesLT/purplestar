# Anthropic API（用于生成 AI 解读）
ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe（支付）
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# 数据库
DATABASE_URL=postgresql://user:pass@localhost:5432/purplestar

# 应用配置
NEXT_PUBLIC_SITE_URL=https://purplestar.cc
NODE_ENV=production

# 数据来源 attribution（MIT 要求）
ATTRIBUTION_REQUIRED=true

# Yandex Metrica counter ID (俄罗斯流量分析 + Yandex SEO 加速)
# 获取:https://metrica.yandex.com → Add counter
NEXT_PUBLIC_YANDEX_METRICA_ID=111617876

# SEO 周报脚本可选配置
# GSC_CREDENTIALS=/path/to/gsc-service-account.json
# BING_API_KEY=your-bing-webmaster-api-key
